
#!/bin/sh

# NexaShare Gradle wrapper launcher for Linux/GitHub Actions.

set -eu

APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
APP_BASE_NAME=${0##*/}
CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

# Resolve Java.
if [ -n "${JAVA_HOME:-}" ]; then
    JAVACMD="$JAVA_HOME/bin/java"

    if [ ! -x "$JAVACMD" ]; then
        echo "ERROR: Java was not found at $JAVACMD" >&2
        exit 1
    fi
else
    JAVACMD=$(command -v java || true)

    if [ -z "$JAVACMD" ]; then
        echo "ERROR: Java is not installed or is not on PATH." >&2
        exit 1
    fi
fi

# Start GradleWrapperMain without eval or nested argument parsing.
# These JVM options are passed as separate arguments.
exec "$JAVACMD" \
    -Xmx64m \
    -Xms64m \
    ${JAVA_OPTS:-} \
    ${GRADLE_OPTS:-} \
    "-Dorg.gradle.appname=$APP_BASE_NAME" \
    -classpath "$CLASSPATH" \
    org.gradle.wrapper.GradleWrapperMain \
    "$@"
